# GoLocal Wheels – web root rules
Options -Indexes

# Homepage shows the "coming soon" page until launch.
# The full site stays reachable at /index.html for testing.
# To launch: delete the next line.
DirectoryIndex coming-soon.html index.html

# Always use https (not for local development)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Private files that must never be downloaded
<FilesMatch "^(_app_path|config|db)\.php$|^shops-research\.json$|^\.ftp-deploy|^\.env|\.sql(\.gz)?$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>
