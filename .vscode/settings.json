{
  "editor.formatOnSave": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[php]": { "editor.defaultFormatter": "bmewburn.vscode-intelephense-client" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.tabSize": 2, "editor.formatOnSave": false },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.tabSize": 2 },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.tabSize": 2 },
  "[yaml]": { "editor.tabSize": 2 },
  "files.exclude": { "**/.ftp-deploy-sync-state.json": true },
  "search.exclude": { "src/app/backups": true, "src/app/sessions": true }
}
