# GoLocal Wheels settings – copy to src/app/.env (local) or app/.env (server)
# and fill in the values. NEVER commit the real file.

APP_ENV=local                 # local | staging | production
SITE_NAME=GoLocal Wheels
SITE_URL=http://localhost:8000

# Database for the website (limited user: SELECT, INSERT, UPDATE, DELETE only)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Database user for migrations and backups (CREATE, ALTER, INDEX …).
# Leave empty to use DB_USER.
DB_MIGRATE_USER=
DB_MIGRATE_PASS=

# Auto-update from GitHub (deploy-hook.php). Long random secret, 40+ characters.
# Must match the DEPLOY_TOKEN secret of the GitHub environment (production / staging).
DEPLOY_TOKEN=
# Which branch this server installs: main (production) or develop (staging)
DEPLOY_BRANCH=main
DEPLOY_REPO=Jeankevin14/golocal-wheels

# Optional: lets you run migrations by hand with migrate.php (leave empty to switch it off)
MIGRATE_TOKEN=

# Booking and shop alerts
ADMIN_EMAIL=
FROM_EMAIL=hello@golocalwheels.com

MAX_BOOKINGS_PER_HOUR=5
